{
	"version": "0.2.0",
	"compounds": [
		{
			"name": "Run project",
			"configurations": ["launch brave 5000", "app start", "frontend 1 serve", "frontend 2 serve", "server websocket", "server redis", "server ai"],
			"stopAll": true,
			"presentation": {
				"group": "1",
				"order": 1
			}
		}
	],
	"configurations": [
		{
			"name": "launch brave 5000",
			"type": "chrome",
			"request": "launch",
			"url": "https://localhost:5000/v",
			"webRoot": "${workspaceFolder}/app",
			"runtimeExecutable": "/usr/bin/brave-browser-stable",
			"runtimeArgs": ["--new-window"],
			"sourceMapPathOverrides": {
				"\\mnt\\c\\*": "C:/*"
			},
			"sourceMaps": true
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "workspace install",
			"command": "vp install",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "app start",
			"command": "vp run start",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/",
			"env": {
				"ENV": "dev"
			}
		},
		{
			"name": "app deploy",
			"command": "vp run deploy",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "app release",
			"command": "vp run release",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "frontend 1 serve",
			"command": "vp run serve",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/mfe-test1/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "frontend 2 serve",
			"command": "vp run serve",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/mfe-test2/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "app create v application",
			"command": "vp node createApp.js",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/scripts/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "server websocket",
			"command": "vp exec tsx WebSocketServer.ts",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/pages/pageHome/components/desktop/apps/chat/server/"
		},
		{
			"name": "server redis",
			"command": "vp node index.js",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/pages/pageHome/components/desktop/apps/testRedis/server/"
		},
		{
			"name": "server ai",
			"command": "vp node serverAi.js",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/pages/pageHome/components/desktop/apps/testAi/server/",
			"env": {
				"GEMINI_API_KEY": "123123"
			}
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "Show versions",
			"command": "vp env doctor",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "ip status",
			"command": "ip addr show",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "ipv4 status",
			"command": "ip -4 addr show",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "ipv6 status",
			"command": "ip -6 addr show | grep 'scope global temporary dynamic' | awk '{print $2}' | cut -d/ -f1 | tail -n 1",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "create ssl keys",
			"command": "openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "port status",
			"command": "sudo ufw status",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "port enable",
			"command": "sudo ufw allow 5002/tcp && sudo ufw reload",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "port disable",
			"command": "sudo ufw delete allow 5002/tcp && sudo ufw reload",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		}
	]
}
