{
	"version": "0.2.0",
	"compounds": [
		{
			"name": "Run project",
			"configurations": ["launch brave 5000", "app start", "frontend 1 serve", "frontend 2 serve", "server websocket", "server redis", "server ai"],
			"stopAll": true,
			"presentation": {
				"group": "1",
				"order": 1
			}
		}
	],
	"configurations": [
		{
			"name": "launch brave 5000",
			"type": "chrome",
			"request": "launch",
			"url": "https://localhost:5000/v",
			"webRoot": "${workspaceFolder}/app",
			"runtimeExecutable": "/usr/bin/brave-browser-stable",
			"runtimeArgs": ["--new-window"],
			"sourceMapPathOverrides": {
				"\\mnt\\c\\*": "C:/*"
			},
			"sourceMaps": true
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "workspace install",
			"command": "vp install",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "app start",
			"command": "vp run start",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/",
			"env": {
				"ENV": "dev"
			}
		},
		{
			"name": "app deploy",
			"command": "vp run deploy",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "app release",
			"command": "vp run release",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "frontend 1 serve",
			"command": "vp run serve",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/mfe-test1/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "frontend 2 serve",
			"command": "vp run serve",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/mfe-test2/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "app create v application",
			"command": "vp node createApp.js",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/scripts/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "server websocket",
			"command": "vp exec tsx WebSocketServer.ts",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/pages/pageHome/components/desktop/apps/chat/server/"
		},
		{
			"name": "server redis",
			"command": "vp node index.js",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/src/pages/pageHome/components/desktop/apps/testRedis/server/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "vp check - format, lint, typecheck",
			"command": "vp check",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "vp versions",
			"command": "vp env doctor",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/host/"
		},
		{
			"name": "---------------------------------",
			"command": "",
			"request": "launch",
			"type": "node-terminal"
		}
	]
}
