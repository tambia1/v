{
	"name": "v",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"ready": "vp check && vp run -r test && vp run -r build",
		"dev": "vp run @v/app#start",
		"prepare": "vp config --no-agent"
	},
	"devDependencies": {
		"vite-plus": "1.2.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
		"vitest": "5.0.4"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "11.19.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
