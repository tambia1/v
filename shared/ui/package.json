{
	"name": "@v/shared-ui",
	"version": "1.0.9",
	"private": true,
	"homepage": "https://tambia1.github.io",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/lib.umd.cjs",
	"module": "./dist/lib.es.js",
	"types": "./dist/lib/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/lib.es.js",
			"require": "./dist/lib.umd.js",
			"types": "./dist/lib/index.d.ts"
		}
	},
	"scripts": {
		"start": "vp dev --host --port 8080",
		"build": "tsc && vp build && tsc -p tsconfig.build.json",
		"preview": "vp preview --port 8081",
		"test": "vp test",
		"coverage": "vp test watch --coverage",
		"deploy": "gh-pages -d ./dist",
		"lint": "vp lint",
		"prepack": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));delete p.devDependencies;delete p.dependencies;fs.writeFileSync('package.json',JSON.stringify(p,null,'\\t')+'\\n')\"",
		"fmt": "vp fmt",
		"check": "vp check"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.0",
		"@tanstack/react-query": "5.81.5",
		"i18next": "23.10.0",
		"i18next-browser-languagedetector": "7.2.0",
		"localforage": "1.10.0",
		"match-sorter": "6.3.4",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-i18next": "14.0.5",
		"react-router-dom": "6.22.1",
		"react-svg": "16.1.33",
		"vite-plugin-dts": "5.1.2",
		"zustand": "4.4.7"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@emotion/babel-plugin": "11.13.5",
		"@rolldown/plugin-babel": "0.2.4",
		"@testing-library/jest-dom": "6.4.2",
		"@testing-library/react": "14.2.1",
		"@types/node": "24.7.0",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.4",
		"dotenv": "16.4.5",
		"gh-pages": "6.1.1",
		"jsdom": "24.0.0",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
		"vite-plus": "1.2.0",
		"vitest": "5.0.4",
		"zustand": "4.5.1"
	}
}
