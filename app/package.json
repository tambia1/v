{
	"name": "@v/app",
	"version": "1.6.0",
	"private": true,
	"homepage": "https://tambia1.github.io",
	"type": "module",
	"scripts": {
		"init": "vp install",
		"start": "vp dev --host --port 5000",
		"build": "tsc && vp build",
		"preview": "vp preview --port 5000",
		"deploy": "gh-pages -d ./dist",
		"release": "node ./src/scripts/release.js",
		"env:dev": "cross-env ENV=dev",
		"env:qa": "cross-env ENV=qa",
		"env:prod": "cross-env ENV=prod",
		"test:units": "vp test",
		"test:coverage": "vp test watch --coverage",
		"test:visuals:install": "playwright install chromium",
		"test:visuals": "playwright test",
		"test:visuals:show": "playwright test --headed",
		"test:visuals:debug": "playwright test --debug",
		"test:visuals:manual": "playwright test --ui",
		"test:visuals:update": "playwright test --update-snapshots --headed",
		"test:visuals:codegen": "playwright codegen --viewport-size=390,844",
		"test:visuals:reporter": "playwright test --reporter=list",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"fmt": "vp fmt",
		"lint": "vp lint"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "1.51.1",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.0",
		"@google/generative-ai": "0.24.1",
		"@modelcontextprotocol/sdk": "1.24.3",
		"@react-oauth/google": "0.12.2",
		"@stylexjs/stylex": "0.16.1",
		"@tanstack/react-query-devtools": "5.90.2",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.3",
		"@v/shared-ui": "file:../shared/ui",
		"cors": "2.8.5",
		"date-fns": "4.1.0",
		"express": "5.1.0",
		"face-api.js": "0.22.2",
		"https": "1.0.0",
		"i18next": "25.5.3",
		"i18next-browser-languagedetector": "8.2.0",
		"localforage": "1.10.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-i18next": "16.0.0",
		"react-router-dom": "7.9.4",
		"react-svg": "16.3.0",
		"redis": "5.8.3",
		"zod": "4.1.12",
		"zustand": "5.0.8"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@emotion/babel-plugin": "11.13.5",
		"@originjs/vite-plugin-federation": "1.4.1",
		"@playwright/test": "1.56.0",
		"@rolldown/plugin-babel": "0.2.4",
		"@tanstack/react-query": "5.90.2",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.4.2",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "24.7.0",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.1",
		"@types/redis": "4.0.11",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.4",
		"cross-env": "10.1.0",
		"dotenv": "17.2.3",
		"gh-pages": "6.3.0",
		"jsdom": "27.0.0",
		"playwright": "1.56.0",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
		"vite-plugin-stylex": "0.13.0",
		"vite-plus": "1.2.0",
		"vitest": "5.0.4"
	}
}
